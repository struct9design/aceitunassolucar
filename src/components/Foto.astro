---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src?: ImageMetadata;
  alt: string;
  /** Texto del hueco si todavía no hay foto ("Foto · …"). */
  hueco?: string;
  class?: string;
  /** Clases para la <img> (p. ej. object-position). */
  imgClass?: string;
  widths?: number[];
  sizes?: string;
  prioridad?: boolean;
  oscuro?: boolean;
  /** Muestra la foto completa sobre blanco en vez de recortarla (tarros). */
  contener?: boolean;
  transitionName?: string;
}

const {
  src,
  alt,
  hueco,
  class: clase = '',
  imgClass = '',
  widths = [400, 640, 960, 1280],
  sizes = '(min-width: 1280px) 600px, 100vw',
  prioridad = false,
  oscuro = false,
  contener = false,
  transitionName,
} = Astro.props;
---

{
  src ? (
    <div class:list={['relative overflow-hidden', contener && 'bg-white', clase]} transition:name={transitionName}>
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        loading={prioridad ? 'eager' : 'lazy'}
        fetchpriority={prioridad ? 'high' : 'auto'}
        decoding="async"
        class:list={['absolute inset-0 h-full w-full', contener ? 'object-contain' : 'object-cover', imgClass]}
      />
    </div>
  ) : (
    <div
      class:list={['relative flex items-end', oscuro ? 'hueco-oscuro' : 'hueco', clase]}
      role="img"
      aria-label={alt}
    >
      {hueco && (
        <span
          class:list={[
            'm-4 px-3 py-2 text-[11px] leading-normal font-medium tracking-[0.14em] uppercase md:m-5',
            oscuro ? 'bg-oro text-profundo' : 'bg-crema text-marca',
          ]}
        >
          {hueco}
        </span>
      )}
    </div>
  )
}
